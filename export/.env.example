# Copy to .env.local for local development; set the same values in Vercel → Project → Settings → Environment Variables.

# Public site address (used for canonical URLs, hreflang, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.asiantechnocast.com

# --- Request a Quote emails (Resend, https://resend.com) ---
RESEND_API_KEY=
# Where RFQs are delivered. Comma-separate several addresses.
RFQ_TO_EMAIL=
# Sender; the domain must be verified in Resend, e.g. "Asian Technocast RFQ <rfq@asiantechnocast.com>"
RFQ_FROM_EMAIL=

# --- Drawing uploads (Vercel Blob, private store). Set automatically when you connect a Blob store. ---
BLOB_READ_WRITE_TOKEN=

# --- Spam protection (Cloudflare Turnstile). Leave empty to disable the widget (honeypot + timing still active). ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
